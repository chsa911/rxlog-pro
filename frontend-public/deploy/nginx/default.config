server {
  listen 80;
  server_name _;

  root /var/www/html;
  index index.html;

  # API -> Gateway (im docker-compose Netzwerk)
  location /api/ {
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_pass http://gateway-java-spring:8080;
  }

  # Public SPA under /books/
  location /books/ {
    try_files $uri $uri/ /books/index.html;
  }

  # Admin SPA under /admin/
  location /admin/ {
    try_files $uri $uri/ /admin/index.html;
  }

  # Website root
  location = / {
    try_files /index.html =404;
  }

  # Static website files (no SPA fallback)
  location / {
    try_files $uri $uri/ =404;
  }
}
